[Unit]
Description=videoBuddy Scheduler-Loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# TODO: User/WorkingDirectory/ExecStart an deine Installation anpassen.
User=CHANGE_ME
WorkingDirectory=/opt/videobuddy
Environment=VIDEOBUDDY_CONFIG=/opt/videobuddy/config.yaml
ExecStart=/opt/videobuddy/.venv/bin/python -m videobuddy.main
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
