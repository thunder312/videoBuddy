[Unit]
Description=videoBuddy Weboberflaeche
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# TODO: User/WorkingDirectory/ExecStart an deine Installation anpassen.
User=CHANGE_ME
WorkingDirectory=/opt/videobuddy
Environment=VIDEOBUDDY_CONFIG=/opt/videobuddy/config.yaml
ExecStart=/opt/videobuddy/.venv/bin/gunicorn --bind 0.0.0.0:8080 --workers 1 --threads 4 --timeout 120 "videobuddy.webapp:create_app()"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
