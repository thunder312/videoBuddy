[Unit]
Description=oerr-pvr Weboberflaeche
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# TODO: User/WorkingDirectory/ExecStart an deine Installation anpassen.
User=CHANGE_ME
WorkingDirectory=/opt/oerr-pvr
Environment=OERR_PVR_CONFIG=/opt/oerr-pvr/config.yaml
ExecStart=/opt/oerr-pvr/.venv/bin/gunicorn --bind 0.0.0.0:8080 --workers 1 --threads 4 --timeout 120 "oerr_pvr.webapp:create_app()"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
